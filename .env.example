# Copy to .env and set ONE provider key. Without any key the system runs in
# offline heuristic mode (rule-based planner, extractive summaries).

# --- Provider (auto-detected from whichever key is set; override explicitly if needed)
# LLM_PROVIDER=groq            # groq | openai | anthropic | openrouter | ollama | offline
# LLM_MODEL=llama-3.3-70b-versatile

# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- Optional
# LLM_TEMPERATURE=0.1
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# MEDICAL_SEARCH_OFFLINE=0     # 1 = never call MedlinePlus/WHO live (use cached corpus)
